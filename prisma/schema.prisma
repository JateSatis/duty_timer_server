generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model OtpCode {
  id                        String       @id @default(uuid())
  otpHash                   String
  otpSalt                   String
  otpCreatedAt              BigInt
  otpExpiresAt              BigInt
  isVerified                Boolean      @default(false)
  verificationAttemptsCount Int          @default(0)
  purpose                   OtpPurpose
  userId                    String?      @unique
  user                      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingUserId             String?      @unique
  pendingUser               PendingUser? @relation(fields: [pendingUserId], references: [id], onDelete: Cascade)
}

model PendingUser {
  id            String   @id @default(uuid())
  email         String   @unique
  nickname      String   @unique
  userType      UserType @default(DEFAULT)
  passwordHash  String
  passwordSalt  String
  userCreatedAt BigInt
  otpCode       OtpCode?
}

model User {
  id                              String              @id @default(uuid())
  createdAt                       BigInt
  email                           String
  nickname                        String              @unique
  avatarImageName                 String?
  userType                        UserType            @default(DEFAULT)
  passwordHash                    String
  passwordSalt                    String
  isOnline                        Boolean             @default(false)
  lastSeenOnline                  BigInt
  isAdmin                         Boolean             @default(false)
  isBanned                        Boolean             @default(false)
  globalChatUnreadMessagesCounter Int                 @default(0)
  events                          Event[]
  sentRequests                    FriendshipRequest[] @relation("sender")
  recievedRequests                FriendshipRequest[] @relation("reciever")
  friends                         Frienship[]         @relation("user1")
  friendOf                        Frienship[]         @relation("user2")
  messages                        Message[]
  device                          Device?
  refreshToken                    RefreshToken?
  settings                        Settings?
  subscription                    Subscription?
  timer                           Timer?
  chats                           Chat[]
  otpCode                         OtpCode?
}

model Device {
  id          String   @id @default(uuid())
  userId      String   @unique
  platform    Platform
  deviceToken String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String  @id @default(uuid())
  token     String
  isRevoked Boolean @default(false)
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id             String  @id @default(uuid())
  active         Boolean @default(false)
  expirationDate BigInt
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id                          String        @id @default(uuid())
  backgroundImageName         String?
  recievedBackgroundImageName String?
  backgroundTint              Boolean       @default(false)
  backgroundAnimation         Boolean       @default(false)
  theme                       Theme         @default(WHITE)
  nicknameColor               NicknameColor @default(BLACK)
  language                    Language      @default(RUSSIAN)
  userId                      String        @unique
  user                        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Timer {
  id              String @id @default(uuid())
  startTimeMillis BigInt
  endTimeMillis   BigInt
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String  @id @default(uuid())
  name      String
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Chat {
  id                   String    @id @default(uuid())
  name                 String
  imageName            String?
  chatType             ChatType
  creationTime         BigInt
  lastUpdateTimeMillis BigInt
  messages             Message[]
  users                User[]
}

model Event {
  id         String @id @default(uuid())
  title      String
  timeMillis BigInt
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendshipRequest {
  id         String @id @default(uuid())
  senderId   String
  sender     User   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recieverId String
  reciever   User   @relation("reciever", fields: [recieverId], references: [id], onDelete: Cascade)

  @@unique([senderId, recieverId])
}

model Frienship {
  id      String @id @default(uuid())
  user1Id String
  user1   User   @relation("user1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id String
  user2   User   @relation("user2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}

model Message {
  id           String       @id @default(uuid())
  text         String
  creationTime BigInt
  isEdited     Boolean      @default(false)
  isRead       Boolean
  chatId       String
  senderId     String
  replyToId    String?
  attachments  Attachment[]
  chat         Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  isRepliedBy  Message[]    @relation("MessageReplies")
}

enum Platform {
  IOS
  ANDROID
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum ChatType {
  GLOBAL
  GROUP
  DIRECT
}

enum Language {
  ENGLISH
  RUSSIAN
  BELORUSIAN
  UKRANIAN
}

enum NicknameColor {
  BLACK
  RED
}

enum Theme {
  WHITE
  BLACK
}

enum UserType {
  DEFAULT
  SOLDIER
  WAITING_FOR_SOLDIER
  OTHER
}
